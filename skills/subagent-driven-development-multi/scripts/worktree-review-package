#!/usr/bin/env bash
# Review package for plans that do not commit: status, stat, diff against HEAD, and new files.
# Usage: worktree-review-package [-C DIR] OUTFILE [PATH...]
set -euo pipefail
if [ "${1:-}" = "-C" ]; then
  cd "$2"
  shift 2
fi
[ $# -ge 1 ] || { echo "usage: worktree-review-package [-C DIR] OUTFILE [PATH...]" >&2; exit 2; }
out=$1
shift
{
  git status --short -- "$@"
  git diff --stat HEAD -- "$@"
  git diff -U10 HEAD -- "$@"
  git ls-files --others --exclude-standard -- "$@" | while IFS= read -r file; do
    echo "=== new file: $file"
    cat "$file"
  done
} > "$out"
echo "$out"
