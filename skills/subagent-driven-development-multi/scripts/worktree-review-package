#!/usr/bin/env bash
# Review package for plans that do not commit: stat and diff from a base to the working tree.
# BASE is a tree or commit id, normally from worktree-snapshot. Default: HEAD.
# Usage: worktree-review-package [-C DIR] [--base BASE] OUTFILE [PATH...]
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
dir=.
base=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
    -C) dir=$2; shift 2 ;;
    --base) base=$2; shift 2 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { echo "usage: worktree-review-package [-C DIR] [--base BASE] OUTFILE [PATH...]" >&2; exit 2; }
out=$1
shift
current=$("$here/worktree-snapshot" -C "$dir")
{
  git -C "$dir" diff --stat "$base" "$current" -- "$@"
  git -C "$dir" diff -U10 "$base" "$current" -- "$@"
} > "$out"
echo "$out"
